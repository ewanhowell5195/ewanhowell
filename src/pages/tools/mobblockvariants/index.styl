@import "buttons.styl"

.container
  max-width: var(--content-width)
  margin: 0 auto
  min-height: calc(100% - var(--header-height))
  padding: 0 20px
  display: flex
  flex-direction: column

h1
  margin: 0
  padding: 22px 0 0

h3
  margin: 20px 0 10px

p
  white-space: pre-wrap

a
  color: var(--color-link-blue)

code
  font-family: monospace
  background-color: var(--color-grey-dark)
  padding: 1px 5px

.how
  box-sizing: border-box
  background-color: var(--color-grey)
  box-shadow: var(--box-shadow)
  margin-top: 20px
  padding: 12px 16px

  summary
    cursor: pointer
    font-weight: 700
    user-select: none

  p
    margin: 12px 0 0

.types
  display: flex
  flex-wrap: wrap
  gap: 10px
  margin-bottom: 20px

.type-option
  box-sizing: border-box
  background-color: var(--color-grey)
  box-shadow: var(--box-shadow)
  padding: 10px 16px
  cursor: pointer
  user-select: none
  font-weight: 700
  transition: filter .15s, background-color .15s

  &:hover
    filter: brightness(1.2)

  &.selected
    background-color: var(--color-download)

.hidden
  display: none

.default-state
  margin-bottom: 20px

  p
    margin: 0 0 12px

#state-rows
  display: flex
  flex-direction: column
  gap: 10px
  margin-bottom: 12px

.state-row
  display: flex
  align-items: center
  gap: 8px

  input
    box-sizing: border-box
    background-color: #fff
    border: none
    color: #000
    padding: 8px 10px
    font-family: Arial
    font-size: 1rem
    width: 220px
    max-width: 40vw

    &:focus
      outline: 2px solid var(--color-link-blue)

  .state-eq
    font-weight: 700

  .remove-row
    background-color: var(--color-grey)
    box-shadow: var(--box-shadow)
    width: 34px
    height: 34px
    flex-shrink: 0
    display: flex
    align-items: center
    justify-content: center
    cursor: pointer
    user-select: none
    transition: filter .15s

    &:hover
      filter: brightness(1.3)

    svg
      width: 18px
      height: 18px
      fill: var(--color-text-white)

#add-row
  display: inline-flex

  &.disabled
    opacity: .5
    pointer-events: none

.controls
  display: flex
  flex-wrap: wrap
  gap: 20px
  margin-top: 20px

  label
    display: flex
    flex-direction: column
    gap: 6px
    flex: 1
    min-width: 260px

  span
    font-weight: 700

  input
    box-sizing: border-box
    background-color: #fff
    border: none
    color: #000
    padding: 10px 12px
    font-family: Arial
    font-size: 1rem

    &:focus
      outline: 2px solid var(--color-link-blue)

#output
  padding: 20px 0 40px
  display: flex
  flex-direction: column
  gap: 20px
  align-items: flex-start

.verdict
  box-sizing: border-box
  margin-top: 30px
  padding: 10px 14px
  width: 100%
  border: 2px dashed var(--color-download)

  &.err
    border-color: var(--color-red-light)

.stats
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr))
  gap: 12px
  width: 100%

.stat
  box-sizing: border-box
  background-color: var(--color-grey)
  padding: 12px
  box-shadow: var(--box-shadow)

  .stat-key
    font-size: .8rem
    opacity: .6
    text-transform: uppercase
    letter-spacing: .05em

  .stat-value
    font-size: 1.1rem
    margin-top: 2px
    word-break: break-word

.buttons
  display: flex
  gap: 12px
  flex-wrap: wrap

.result-json
  box-sizing: border-box
  width: 100%
  min-height: 320px
  background-color: var(--color-grey)
  color: var(--color-text-white)
  border: none
  box-shadow: var(--box-shadow)
  padding: 12px
  font-family: monospace
  font-size: .8rem
  resize: vertical
  white-space: pre

.errors
  box-sizing: border-box
  background-color: var(--color-grey)
  padding: 12px 16px
  box-shadow: var(--box-shadow)
  width: 100%

  h2
    margin: 0 0 8px
    font-size: 1.1rem

  p
    margin: 0
