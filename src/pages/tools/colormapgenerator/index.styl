@import "buttons.styl"

.container
  max-width: var(--content-width)
  margin: 0 auto
  min-height: calc(100% - var(--header-height))
  padding: 0 20px 40px
  display: flex
  flex-direction: column

h1
  margin: 0
  padding: 22px 0 0

h2
  margin: 0

h3
  margin: 20px 0 10px

p
  white-space: pre-wrap

a
  color: var(--color-link-blue)

code
  font-family: monospace
  background-color: var(--color-grey-dark)
  padding: 1px 5px

.hidden
  display: none !important

.how
  box-sizing: border-box
  background-color: var(--color-grey)
  box-shadow: var(--box-shadow)
  margin-top: 20px
  padding: 12px 16px

  summary
    cursor: pointer
    font-weight: 700
    user-select: none

  p
    margin: 12px 0 0

  pre
    background-color: var(--color-grey-dark)
    padding: 10px 14px
    overflow-x: auto
    font-family: monospace
    margin: 12px 0 0

.convert-versions
  display: flex
  flex-wrap: wrap
  gap: 0 30px

#version, #convert-from, #convert-to
  box-sizing: border-box
  background-color: var(--color-grey)
  box-shadow: var(--box-shadow)
  color: var(--color-text-white)
  border: none
  padding: 10px 16px
  font-size: 1rem
  font-weight: 700
  cursor: pointer
  width: 220px
  max-width: 100%

  &:focus
    outline: 2px solid var(--color-link-blue)

.types
  display: flex
  flex-wrap: wrap
  gap: 10px

.type-option
  box-sizing: border-box
  background-color: var(--color-grey)
  box-shadow: var(--box-shadow)
  padding: 10px 16px
  cursor: pointer
  user-select: none
  font-weight: 700
  transition: filter .15s, background-color .15s

  &:hover
    filter: brightness(1.2)

  &.selected
    background-color: var(--color-download)

#mode-hint, #size-hint
  margin-top: 12px
  opacity: .8
  font-size: .9rem

#status
  margin-top: 20px
  font-weight: 700

  &:empty
    display: none

#page-tabs
  margin-top: 30px

#results
  display: flex
  flex-direction: column
  gap: 40px
  margin-top: 30px

section
  display: flex
  flex-direction: column

  & > p
    margin: 12px 0 0

#grid-info, .convert-info
  opacity: .8
  font-size: .9rem

.channel-tabs
  margin: 16px 0

#grid-holder, #convert-output
  canvas
    image-rendering: pixelated
    width: 384px
    max-width: 100%
    height: auto
    background-image: url("/assets/images/misc/transparent_dark.webp")

#convert-output
  display: flex
  flex-direction: column
  align-items: flex-start

  canvas
    margin-top: 16px

  p
    margin: 12px 0 0

.buttons
  display: flex
  flex-wrap: wrap
  gap: 10px
  margin-top: 16px

.triangle-wrap
  position: relative
  // cancel out the 8px hover padding baked into the canvas (16px at 2x display)
  margin: 0 -16px -16px
  align-self: flex-start
  max-width: 100%
  font-size: 0

  // transparency checkerboard, inset to match the 8px padding baked into the canvas (8/272)
  &::before
    content: ""
    position: absolute
    inset: 2.9412%
    background: url("/assets/images/misc/transparent_dark.webp")

  canvas
    position: relative
    image-rendering: pixelated
    width: 544px
    max-width: 100%
    height: auto
    cursor: crosshair

#triangle-tooltip
  position: absolute
  top: 24px
  right: 24px
  background-color: var(--color-grey-dark)
  box-shadow: var(--box-shadow)
  padding: 8px 12px
  pointer-events: none
  z-index: 10
  max-width: 260px
  font-size: .9rem

  .tooltip-biome
    display: flex
    align-items: center
    gap: 6px
    white-space: nowrap

  .tooltip-hex
    opacity: .7
    font-family: monospace
    font-size: .8rem
    margin-left: auto
    padding-left: 12px

  .tooltip-meta
    opacity: .7
    margin-top: 4px
    white-space: pre-line

#fixed-wrap
  h3
    margin-bottom: 0

  &.hidden
    display: none

#fixed-biomes
  display: flex
  flex-wrap: wrap
  gap: 8px
  margin-top: 16px

.fixed-chip
  display: flex
  align-items: center
  gap: 10px
  background-color: var(--color-grey)
  box-shadow: var(--box-shadow)
  padding: 8px 12px
  font-size: .9rem

.fixed-chip-text
  display: flex
  flex-direction: column

.fixed-chip-hex
  opacity: .7
  font-size: .8rem
  font-family: monospace

.swatch
  display: inline-block
  width: 14px
  height: 14px
  flex-shrink: 0
  border: 1px solid rgba(255, 255, 255, .5)

.swatch-large
  width: 28px
  height: 28px

.table-wrap
  overflow-x: auto
  margin-top: 16px
  background-color: var(--color-grey)
  box-shadow: var(--box-shadow)

#biome-table
  border-collapse: collapse
  width: 100%
  font-size: .9rem

  th, td
    text-align: left
    padding: 6px 12px
    white-space: nowrap

  th
    background-color: var(--color-grey-dark)
    position: sticky
    top: 0

  tr:nth-child(even) td
    background-color: rgba(0, 0, 0, .15)

  .colour-cell
    display: flex
    align-items: center
    gap: 6px
