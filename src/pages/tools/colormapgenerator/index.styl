@import "buttons.styl"

.container
  max-width: var(--content-width)
  margin: 0 auto
  min-height: calc(100% - var(--header-height))
  padding: 0 20px 40px
  display: flex
  flex-direction: column

h1
  margin: 0
  padding: 22px 0 0

h2
  margin: 0 0 8px
  font-size: 1.2rem

  &.sub
    margin-top: 16px

p
  white-space: pre-wrap

a
  color: var(--color-link-blue)

code
  font-family: monospace
  background-color: var(--color-grey-dark)
  padding: 1px 5px

.hidden
  display: none !important

#status
  margin-top: 20px
  font-weight: 700

  &:empty
    display: none

.tabs
  display: flex
  gap: 10px
  margin-top: 16px

.tab
  background-color: var(--color-grey-dark)
  cursor: pointer
  border-top: 2px solid transparent
  transition: background-color .15s, border-top .15s
  user-select: none
  padding: 10px 15px

  &.active
    background-color: var(--color-grey)
    border-top: 2px solid var(--color-red-light)

#converter-tab > p
  margin: 16px 0 0

.workspace
  display: grid
  grid-template-columns: minmax(0, 300px) minmax(0, 1fr)
  gap: 20px
  padding-top: 20px

.column
  display: flex
  flex-direction: column
  gap: 20px
  min-width: 0

.panel
  background-color: var(--color-grey)
  padding: 16px
  box-shadow: var(--box-shadow)

  p
    margin: 0 0 8px

.hint
  opacity: .75
  font-size: .9rem

.note
  font-size: .9rem
  color: var(--color-text-optifine)

  &:empty
    display: none

#generator-tab[data-view="vanilla"] .grid-only, #generator-tab[data-view="grid"] .vanilla-only
  display: none

select
  box-sizing: border-box
  width: 100%
  background-color: var(--color-grey-light)
  color: var(--color-text-white)
  border: none
  padding: 10px 12px
  font: inherit
  font-weight: 700
  cursor: pointer

  &:focus
    outline: 2px solid var(--color-download)

.convert-versions
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 10px

  label
    display: flex
    flex-direction: column
    gap: 4px

.choices
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(76px, 1fr))
  gap: 10px

  &.text-choices
    grid-template-columns: repeat(2, minmax(0, 1fr))

.choice
  display: flex
  flex-direction: column
  gap: 6px
  padding: 8px
  background-color: var(--color-grey-light)
  outline: 2px solid transparent
  cursor: pointer
  user-select: none
  font-size: .9rem
  transition: background-color .15s

  &:hover
    background-color: var(--color-grey-lighter)

  &.selected
    outline-color: var(--color-download)

  span
    font-weight: 700

  small
    opacity: .7
    font-size: .8rem

  canvas
    width: 100%
    aspect-ratio: 1
    background-image: url("/assets/images/misc/transparent_dark.webp")

.save
  display: flex
  flex-direction: column
  gap: 10px

  .button-download
    justify-content: flex-start

.triangle-wrap
  position: relative
  font-size: 0

  // transparency checkerboard, inset to match the 8px padding baked into the canvas (8/272)
  &::before
    content: ""
    position: absolute
    inset: 2.9412%
    background: url("/assets/images/misc/transparent_dark.webp")

  canvas
    position: relative
    display: block
    image-rendering: pixelated
    width: 100%
    height: auto
    cursor: crosshair

#triangle-tooltip
  position: absolute
  top: 12%
  right: 6%
  background-color: var(--color-grey-dark)
  box-shadow: var(--box-shadow)
  padding: 8px 12px
  pointer-events: none
  z-index: 10
  width: 260px
  max-width: 70%
  box-sizing: border-box
  font-size: .85rem

  .tooltip-group + .tooltip-group
    margin-top: 8px

  .tooltip-group .tooltip-hex
    margin-left: 0
    padding-left: 0
    opacity: 1

  .tooltip-count
    margin-left: auto
    opacity: .7
    font-size: .8rem

  .tooltip-names
    margin-top: 2px
    opacity: .85
    font-size: .8rem
    overflow-wrap: anywhere

#triangle-tooltip, .grid-tooltip
  .tooltip-biome
    display: flex
    align-items: center
    gap: 6px
    white-space: nowrap

  .tooltip-hex
    opacity: .7
    font-family: monospace
    font-size: .8rem
    margin-left: auto
    padding-left: 12px

  .tooltip-meta
    opacity: .7
    margin-top: 4px
    white-space: pre-line

.grid-wrap
  position: relative
  margin: 0 auto
  align-self: center

  canvas
    display: block
    image-rendering: pixelated
    width: 100%
    height: auto
    cursor: crosshair

.grid-tooltip
  position: absolute
  background-color: var(--color-grey-dark)
  box-shadow: var(--box-shadow)
  padding: 8px 12px
  pointer-events: none
  z-index: 10
  font-size: .85rem
  white-space: nowrap

#grid-info
  margin: 10px 0 0

#convert-output
  display: flex
  flex-direction: column
  gap: 10px

  p
    margin: 0

  .button-download
    align-self: flex-start

#fixed-biomes
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr))
  gap: 8px

.fixed-chip
  display: flex
  align-items: center
  gap: 10px
  background-color: var(--color-grey-light)
  padding: 8px 10px
  font-size: .9rem
  min-width: 0

.fixed-chip-text
  display: flex
  flex-direction: column
  min-width: 0
  overflow-wrap: anywhere

.fixed-chip-hex
  opacity: .7
  font-size: .8rem
  font-family: monospace

.swatch
  display: inline-block
  width: 14px
  height: 14px
  flex-shrink: 0
  border: 1px solid #000

.swatch-large
  width: 28px
  height: 28px

.setup pre
  background-color: var(--color-grey-dark)
  padding: 10px 14px
  overflow-x: auto
  font-family: monospace
  font-size: .85rem
  margin: 0

.biome-data
  margin-top: 20px

.table-wrap
  overflow-x: auto

#biome-table
  border-collapse: collapse
  width: 100%
  font-size: .9rem

  th, td
    text-align: left
    padding: 6px 12px
    white-space: nowrap

  th
    background-color: var(--color-grey-dark)
    position: sticky
    top: 0
    z-index: 1

  tr:nth-child(even) td
    background-color: rgba(0, 0, 0, .15)

  .colour-cell
    display: flex
    align-items: center
    gap: 6px

@media only screen and (max-width: 768px)
  .workspace
    grid-template-columns: minmax(0, 1fr)

  #generator
    display: flex
    flex-direction: column

    .column
      display: contents

  .download
    order: 1

  #fixed-wrap, .setup
    order: 2
