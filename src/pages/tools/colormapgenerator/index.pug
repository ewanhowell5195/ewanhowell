template#download-icon: include /assets/images/svg/download.svg
.container
  h1 Biome Colormap Generator
  p This is a tool that generates Minecraft biome colormaps for any version from 1.16.2 onwards, using biome data read from each version's game files. It maps where each biome sits on the vanilla colormap, makes OptiFine grid colormaps and biome ID lists, and converts grid colormaps between versions.
  .tabs#page-tabs
    .tab.active(data-tab = "vanilla") Vanilla Generator
    .tab(data-tab = "grid") Grid Generator
    .tab(data-tab = "converter") Grid Converter
  #status
  #generator-tab.hidden(data-view = "vanilla")
    .workspace#generator
      .column
        .panel
          h2 Version
          select#version
        .panel
          h2 Colormap
          .choices.channel-choices
        .panel.grid-only
          h2 Grid mode
          .choices.text-choices#modes
            .choice.selected(data-mode = "flat")
              span Flat
              small One colour per biome at every height, like vanilla
            .choice(data-mode = "altitude")
              span Altitude
              small Colours shift as it gets colder above Y=80
          .size-wrap.hidden
            h2.sub Grid size
            .choices.text-choices#sizes
              .choice.selected(data-size = "full")
                span Full height
                small#size-full-note
              .choice(data-size = "square")
                span Square
                small Y 0 to 255, the classic 256×256
        .panel.download
          h2 Download
          .save
            .button-download.grid-only#download-grid
              span Grid colormap
            .button-download.grid-only#download-ids
              span Biome ID list
            .button-download.vanilla-only#download-texture
              span Colormap map
      .column
        .panel.vanilla-only
          h2 Vanilla colormap
          p.hint Each biome samples one pixel, picked by its temperature and downfall, and uses that colour at every height. Hover a marker to see its biomes. The centre marker is the colour of held and dropped blocks.
          .triangle-wrap#triangle-wrap
            #triangle-tooltip.hidden
        .panel.grid-only
          h2 OptiFine grid
          p.hint Each column is a biome by numeric ID, and each row is a world Y level, starting at the bottom of the world. Unused columns use plains as a neutral default for mod biomes. Hover the grid to see the biome and Y level.
          #grid-holder
          p.note#grid-info
        .panel#fixed-wrap
          h2 Hardcoded colours
          p.hint These biomes ignore the vanilla colormap and always use the same colour. In a grid colormap they are ordinary columns that OptiFine reads like any other, so the generated grid fills them with that colour at every height, even in Altitude mode.
          #fixed-biomes
        .panel.grid-only.setup
          h2 Resource pack setup
          p.hint Vanilla #[code grass.png] and #[code foliage.png] only use the vanilla format, so a grid colormap needs OptiFine. Save the grid in #[code assets/minecraft/optifine/colormap/blocks/] with this properties file next to it.
          pre#properties-example
    .panel.biome-data
      h2 Biome data
      p.hint Every biome in this version. Numeric IDs are the column positions in the grid colormap.
      .table-wrap
        table#biome-table
  #converter-tab.hidden
    p Converts an OptiFine grid colormap from one version to another. Every biome column moves to its numeric ID in the target version, and biomes the source version doesn't have get their vanilla column generated.
    .workspace
      .column
        .panel
          h2 Versions
          .convert-versions
            label
              span.hint From
              select#convert-from
            label
              span.hint To
              select#convert-to
        .panel
          h2 Colormap
          p.hint Used to generate the columns for new biomes.
          .choices.channel-choices
      .column
        .panel
          h2 Grid colormap
          p.hint The grid PNG made for the version you are converting from.
          file-input(accept = ".png,image/png")
        .panel#convert-result
          h2 Converted grid
          p.hint#convert-empty Provide a grid colormap to convert it.
          #convert-output
